FROM node:22-alpine
ENV NODE_ENV=development
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev
COPY backend/server.js ./server.js
COPY backend/src ./src
COPY frontend /app/frontend
RUN mkdir -p /app/backend/uploads/job-photos
EXPOSE 5000
CMD ["npm", "start"]
