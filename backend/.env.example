# Cấu hình cổng chạy ứng dụng
PORT=5000
NODE_ENV=development
DEMO_MODE=true
# node server.js mặc định demo ở development. Đặt false để chọn MySQL.
# Production bắt buộc NODE_ENV=production và DEMO_MODE=false; demo bị từ chối.

# Cấu hình Cơ sở dữ liệu MySQL (mặc định cho XAMPP / WampServer)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=123456za
DB_NAME=cleanova_db
DB_PORT=3306

# Khóa bí mật mã hóa JWT (JSON Web Token) - Hãy đổi thành chuỗi ngẫu nhiên bảo mật cao khi deploy
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=7d
